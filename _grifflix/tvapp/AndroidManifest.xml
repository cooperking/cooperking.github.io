<?xml version="1.0" encoding="utf-8"?>
<!-- Grifflix on a Fire TV: the Grifflix page, full screen, worked by the remote (see README.md) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.cooperking.grifflix">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- to hand its own updates to the TV's installer (which still asks to confirm) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="Grifflix"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:allowBackup="true"
        android:usesCleartextTraffic="false"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <activity
            android:name=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:banner="@drawable/banner"
            android:label="Grifflix"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name=".ApkProvider"
            android:authorities="io.github.cooperking.grifflix.apk"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
