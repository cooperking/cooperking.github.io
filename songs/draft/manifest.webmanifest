{
  "name": "Draft · John’s Song of the Day",
  "short_name": "SotD draft",
  "id": "/songs/draft/",
  "start_url": "/songs/draft/",
  "scope": "/songs/draft/",
  "display": "standalone",
  "background_color": "#09696d",
  "theme_color": "#09696d",
  "icons": [
    {
      "src": "/songs/draft/icon-192.png?v=m202611",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/songs/draft/icon-512.png?v=m202611",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/songs/draft/icon-maskable-512.png?v=m202611",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/songs/draft/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "name",
      "files": [
        {
          "name": "file",
          "accept": [
            ".zip",
            ".csv",
            "application/zip",
            "application/x-zip-compressed",
            "text/csv",
            "text/comma-separated-values"
          ]
        }
      ]
    }
  }
}
